---
import Base from '../../layouts/Base.astro';
import ImpactBar from '../../components/ImpactBar.astro';
import { digest } from '../../lib/announcementsToday';
import { parseTimestamp, formatLong, formatTime } from '../../lib/companies';

const day = digest.date ? new Date(`${digest.date}T12:00:00Z`) : null;
const dayLabel = day ? formatLong(day) : null;
---

<Base
  title="Today's Highest-Impact UK Market Announcements | AngloEdge"
  description={dayLabel
    ? `The highest-impact UK regulatory announcements (RNS and other wires) on ${dayLabel}, scored and explained by AngloEdge.`
    : 'The day\'s highest-impact UK regulatory announcements (RNS and other wires), scored and explained by AngloEdge.'}
>
  <div class="max-w-4xl mx-auto px-6 py-14">

    <div class="mb-10">
      <p class="text-brass font-sans text-xs font-semibold uppercase tracking-widest mb-3">Market Announcements</p>
      <h1 class="font-serif text-4xl font-bold text-navy mb-4">Today's highest-impact UK market announcements</h1>
      {dayLabel && <p class="text-gray-600 text-sm mb-4"><time datetime={digest.date}>{dayLabel}</time></p>}
      <p class="text-gray-600 text-sm leading-relaxed max-w-prose">
        The day's most significant regulatory announcements (RNS and other wires) from UK-listed
        companies, scored for impact and explained by AngloEdge.
      </p>
    </div>

    {digest.items.length === 0 ? (
      <p class="text-gray-600 text-sm leading-relaxed max-w-prose border-t border-gray-100 pt-6">
        {dayLabel
          ? `No announcements on ${dayLabel} reached the digest's impact threshold.`
          : 'The first digest has not been published yet.'}
      </p>
    ) : (
      <ol class="divide-y divide-gray-100 border-y border-gray-100">
        {digest.items.map((item) => {
          const d = parseTimestamp(item.timestamp);
          return (
            <li class="py-6">
              <div class="flex flex-wrap items-center gap-x-3 gap-y-1 font-sans text-xs uppercase tracking-wide text-gray-500">
                {item.slug
                  ? <a href={`/companies/${item.slug}/`} class="font-semibold text-navy hover:underline">{item.company}</a>
                  : <span class="font-semibold text-navy">{item.company}</span>}
                {item.ticker && <span class="font-semibold text-brass">{item.ticker}</span>}
                {d && <time datetime={item.timestamp}>{formatTime(d)}</time>}
              </div>
              <h2 class="font-serif text-lg font-bold text-navy leading-tight mt-1.5">{item.headline}</h2>
              <ImpactBar score={item.score} />
              {item.insight && <p class="mt-3 text-gray-700 text-sm leading-relaxed max-w-prose">{item.insight}</p>}
            </li>
          );
        })}
      </ol>
    )}

    <p class="mt-10 font-sans text-xs text-gray-500 leading-relaxed max-w-prose">
      Impact scores and insights are AngloEdge's own analysis of each announcement's headline and are not
      investment advice.
    </p>

    <div class="mt-8">
      <a href="/companies/" class="text-sm font-sans font-medium text-navy hover:underline">Browse all companies →</a>
    </div>
  </div>
</Base>
